<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby.ContentViews.Elements.ContactView"
             x:Name="thisControl">
    <Border Style="{StaticResource Contacts}">
        <Grid ColumnDefinitions="Auto, *" Padding="7">
            <Image Grid.Column="0" Source="{Binding Image, Source={x:Reference thisControl}}" Margin="5" Scale="1.2"/>
            <Grid Grid.Column="1" HorizontalOptions="Start" RowDefinitions="*, *" Margin="5,0">
                <Label Style="{StaticResource BoldLabel}" Grid.Row="0" Text="{Binding Title, Source={x:Reference thisControl}}" />
                <Label Style="{StaticResource GrayLabel}" Grid.Row="1" Text="{Binding Text, Source={x:Reference thisControl}}" Margin="0,5,0,0"/>
            </Grid>
        </Grid>
    </Border>
</ContentView>
