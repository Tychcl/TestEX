<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby.ContentViews.Elements.SettingsItem"
             x:Name="thisControl">
    <Grid ColumnDefinitions="auto, *" ColumnSpacing="10">
        <Image Grid.Column="0" Source="{Binding Image, Source={x:Reference thisControl}}" Margin="5" Scale="1.2"/>
        <Label Grid.Column="1" Style="{StaticResource EditLabel}" Text="{Binding Text, Source={x:Reference thisControl}}" HorizontalOptions="Start"/>
    </Grid>
</ContentView>
