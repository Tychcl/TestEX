<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby.ContentViews.Elements.TaskView"
             x:Name="thisControl"
             BindingContext="{Binding Task, Source={x:Reference thisControl}}">
    <Border Style="{StaticResource Card}" StrokeShape="15">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding GoToDetailCommand, Source={x:Reference thisControl}}"
                              CommandParameter="{Binding .}"/>
        </Border.GestureRecognizers>
        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontAttributes="Bold" FontSize="16" TextColor="Black"/>
            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Reward, StringFormat='{0:F2}'}" TextColor="Green" HorizontalOptions="End"/>
            <Label Grid.Row="1" Grid.Column="0" Text="{Binding Location}" TextColor="Gray" FontSize="12"/>
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Deadline, StringFormat='{0:dd.MM.yyyy}'}" TextColor="Gray" FontSize="12" HorizontalOptions="End"/>
        </Grid>
    </Border>
</ContentView>