<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby.ContentViews.Entry.Password"
             x:Name="thisControl">
    <HorizontalStackLayout>
        <Entry x:Name="PEntry" 
               HorizontalOptions="Fill" 
               Text="{Binding Text, Source={x:Reference thisControl}}" 
               Placeholder="{Binding Placeholder, Source={x:Reference thisControl}}"
               IsPassword="True" />

        <ImageButton x:Name="ToggleButton" 
                     Source="eye_closed.png" 
                     Clicked="OnTogglePasswordClicked" 
                     HorizontalOptions="End"/>
    </HorizontalStackLayout>
</ContentView>