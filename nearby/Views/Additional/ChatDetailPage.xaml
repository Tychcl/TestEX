<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby.Views.Additional.ChatDetailPage"
             xmlns:viewModels="clr-namespace:nearby.ViewModels"
             xmlns:models="clr-namespace:nearby.Models"
             xmlns:converters="clr-namespace:nearby.Classes"
             x:DataType="viewModels:ChatDetailViewModel"
             Title="{Binding Chat.OtherUser.FullName, FallbackValue='Чат'}"
             Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <converters:IsCurrentUserConverter x:Key="IsCurrentUserConverter"/>
        <converters:MessageAlignmentConverter x:Key="MessageAlignmentConverter"/>
        <converters:MessageBackgroundConverter x:Key="MessageBackgroundConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="*, Auto">
        <!-- Список сообщений -->
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Messages}"
                        SelectionMode="None"
                        RemainingItemsThreshold="3"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreMessagesCommand}"
                        VerticalOptions="End">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Message">
                    <Border Background="#f2f2f2" Stroke="#e1e1e1" Margin="5" HorizontalOptions="{Binding layout}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer 
        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ChatDetailViewModel}}, 
                          Path=OpenMenuCommand}"
        CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{Binding corner}"/>
                        </Border.StrokeShape>
                        <Grid Padding="5" RowDefinitions="Auto, Auto, *" HorizontalOptions="End">
                            <Label Grid.Row="0" Text="{Binding Content}" TextColor="Black" HorizontalOptions="Start"/>
                            <Label Grid.Row="1" Text="{Binding CreatedAt, StringFormat='{0:dd.MM HH:mm}'}" HorizontalOptions="End" Margin="10, 5, 0,0" FontSize="12" TextColor="Gray"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Поле ввода сообщения -->
        <Grid Grid.Row="1"
              Padding="10"
              ColumnDefinitions="*, Auto"
              BackgroundColor="White">
            <Editor Grid.Column="0"
                Placeholder="Введите сообщение..."
                Text="{Binding NewMessageText}"
                AutoSize="TextChanges"
                MaximumHeightRequest="150"
                Margin="0,5"
                VerticalOptions="Center"/>
            <Button Grid.Column="1"
                    Text="Отправить"
                    Command="{Binding SendMessageCommand}"
                    Margin="5,0,0,0"
                    BackgroundColor="#3498db"
                    TextColor="White"/>
        </Grid>
    </Grid>
</ContentPage>