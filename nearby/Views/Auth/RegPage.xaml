<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:nearby.ViewModels"
             xmlns:CVE="clr-namespace:nearby.ContentViews.Entry"
             x:Class="nearby.Views.Auth.RegPage"
             x:DataType="viewModels:RegViewModel">
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
            <Label Text="Регистрация" FontSize="24" HorizontalOptions="Center"/>
            <Entry Placeholder="ФИО" Text="{Binding FullName}"/>
            <Entry Placeholder="Телефон" Text="{Binding Phone}" Keyboard="Telephone"/>
            <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email"/>
            <CVE:Password Text="{Binding Password}" Placeholder="Введите пароль" />
            <CVE:Password Text="{Binding Confirm}" Placeholder="Подтвердите пароль" />
            <Label IsVisible="{Binding HasErrors}" 
                Text="{Binding ErrorMessage}" 
                TextColor="Red"/>
            <Button Text="Зарегистрироваться" Command="{Binding RegisterCommand}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>