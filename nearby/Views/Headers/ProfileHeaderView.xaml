<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby.Views.Headers.ProfileHeaderView"
             xmlns:local="clr-namespace:nearby.ViewModels"
             x:DataType="local:ProfileViewModel">
    <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Center">
        <!--<Label Text="{Binding IsOwnProfile}" TextColor="Red"/>-->
        <ImageButton Source="edit.svg" 
                     Command="{Binding GoToEditCommand}" 
                     Scale="0.7"/>
        <ImageButton Source="logout.svg" 
                     Command="{Binding LogoutCommand}"
                     Scale="0.7"/>
    </HorizontalStackLayout>
</ContentView>