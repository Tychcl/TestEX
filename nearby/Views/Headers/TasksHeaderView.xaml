<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby.Views.Headers.TasksHeaderView">
    
    <Grid BackgroundColor="#2196F3">
            <Label Text="Задачи" TextColor="White" FontSize="18"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
            <Button Text="+" Command="{Binding GoToCreateTaskCommand}"
                    BackgroundColor="Transparent" TextColor="White"
                    FontSize="24" HorizontalOptions="End" VerticalOptions="Center"
                    WidthRequest="40"/>
        </Grid>
        
</ContentView>
