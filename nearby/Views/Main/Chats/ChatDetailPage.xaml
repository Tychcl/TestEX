<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby.Views.Main.ChatDetailPage"
             xmlns:viewModels="clr-namespace:nearby.ViewModels"
             xmlns:header="clr-namespace:nearby.ContentViews.Headers"
             xmlns:element="clr-namespace:nearby.ContentViews.Elements"
             xmlns:models="clr-namespace:nearby.Models"
             xmlns:converters="clr-namespace:nearby.Classes.Interface.Converters"
             x:DataType="viewModels:ChatDetailViewModel"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto, *, Auto">
        <header:BaseHeaderView Grid.Row="0" BackCommand="{Binding GoBackCommand}" InnerMargin="10,20,10,12" MenuIsVisible="True">
            <header:BaseHeaderView.ExtraContent>
                <HorizontalStackLayout Margin="0,5" Spacing="5">
                    <element:ProfileImageView ImageSize="45"/>
                    <VerticalStackLayout>
                        <Label Style="{StaticResource SectionTitle}" Text="{Binding Chat.Name, FallbackValue='Чат'}" Padding="0" Margin="0" VerticalTextAlignment="Start" FontFamily="OpenSansBold"/>
                        <Label Style="{StaticResource CommonLabel}" Text="{Binding Chat.OtherUser.LastSeenAt, FallbackValue='Чат'}" Padding="0" VerticalTextAlignment="Start" TextColor="{DynamicResource CTextSecondary}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </header:BaseHeaderView.ExtraContent>
        </header:BaseHeaderView>
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Messages}"
                        SelectionMode="None"
                        RemainingItemsThreshold="3"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreMessagesCommand}"
                        VerticalOptions="End">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Message">
                    <Border Background="#f2f2f2" Stroke="#e1e1e1" Margin="5" HorizontalOptions="{Binding layout}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer 
        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ChatDetailViewModel}}, 
                          Path=OpenMenuCommand}"
        CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{Binding corner}"/>
                        </Border.StrokeShape>
                        <Grid Padding="5" RowDefinitions="Auto, Auto, *" HorizontalOptions="End">
                            <Label Grid.Row="0" Text="{Binding Content}" TextColor="Black" HorizontalOptions="Start"/>
                            <Label Grid.Row="1" Text="{Binding CreatedAt, StringFormat='{0:dd.MM HH:mm}'}" HorizontalOptions="End" Margin="10, 5, 0,0" FontSize="12" TextColor="Gray"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2"
              Padding="10"
              ColumnDefinitions="*, Auto"
              BackgroundColor="White">
            <Editor Grid.Column="0"
                Placeholder="Введите сообщение..."
                Text="{Binding NewMessageText}"
                AutoSize="TextChanges"
                MaximumHeightRequest="150"
                Margin="0,5"
                VerticalOptions="Center"/>
            <Button Grid.Column="1"
                    Text="Отправить"
                    Command="{Binding SendMessageCommand}"
                    Margin="5,0,0,0"
                    BackgroundColor="#3498db"
                    TextColor="White"/>
        </Grid>
    </Grid>
</ContentPage>