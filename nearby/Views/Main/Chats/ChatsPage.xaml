<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:header="clr-namespace:nearby.ContentViews.Headers"
             xmlns:element="clr-namespace:nearby.ContentViews.Elements"
             x:Class="nearby.Views.Main.ChatsPage"
             xmlns:viewModels="clr-namespace:nearby.ViewModels"
             xmlns:models="clr-namespace:nearby.Models"
             Title="Чаты"
             x:DataType="viewModels:ChatsViewModel"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto, *" RowSpacing="0">
        <header:BaseHeaderView Grid.Row="0"
                               Text="Чаты"
                               BackIsVisible="False"
                               Icon="{StaticResource ChatCreate}"
                               MenuIsVisible="True"
                               Command="{Binding CreateChatCommand}"/>
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     VerticalOptions="FillAndExpand">
            <CollectionView ItemsSource="{Binding Chats}"
                            SelectionMode="None"
                            RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Chat">
                        <Border Style="{StaticResource Card}" Padding="5">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ChatsViewModel}}, Path=GoToChatDetailCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" Padding="5">
                                <element:ProfileImageView Grid.Column="0" ImageSize="50" Image="test_profile_image.jpg"/>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Start" Spacing="2">
                                    <Label Text="{Binding Name}" Style="{StaticResource BoldCommonLabel}"/>
                                    <Label Text="{Binding LastMessage.Content}" Style="{StaticResource CommonLabel}" TextColor="{DynamicResource CTextSecondary}" MaxLines="1" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Start" Spacing="4">
                                    <Label Text="{Binding LastMessage.CreatedAt, StringFormat='{0:dd.MM HH:mm}'}"
                                           Style="{StaticResource CommonLabel}" FontSize="11"
                                           HorizontalOptions="End"/>
                                    <Border Background="{DynamicResource CPrimary}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="6,2"
                                            HorizontalOptions="End"
                                            VerticalOptions="End"
                                            IsVisible="{Binding UnreadCount, Converter={StaticResource GreaterThanZeroConverter}}">
                                        <Label Text="{Binding UnreadCount}" TextColor="{DynamicResource CBackground}" FontSize="11"/>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>