<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:header="clr-namespace:nearby.ContentViews.Headers"
             xmlns:el="clr-namespace:nearby.ContentViews.Elements"
             xmlns:ih="clr-namespace:nearby"
             x:Class="nearby.Views.Main.CreateChatPage"
             xmlns:viewModels="clr-namespace:nearby.ViewModels"
             xmlns:models="clr-namespace:nearby.Models"
             x:DataType="viewModels:CreateChatViewModel"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout>
        <header:BaseHeaderView Icon="{StaticResource Confirm}" MenuIsVisible="True" Text="{Binding PageTitle}" BackCommand="{Binding GoBackCommand}" Command="{Binding CreateChatCommand}"/>
        <Border Style="{StaticResource Card}" Padding="0">
            <Grid ColumnDefinitions="Auto, *">
                <Image Grid.Column="0" ih:IconHelper.Icon="{StaticResource Search}" HorizontalOptions="Start" WidthRequest="28" HeightRequest="28" Margin="6"/>
                <Border Grid.Column="1" Stroke="Transparent" BackgroundColor="Transparent" Margin="0" Padding="0">
                    <Entry  Margin="0" Placeholder="Поиск по имени, телефону или почте..." />
                </Border>
            </Grid>
        </Border>
        <Grid RowDefinitions="Auto, *" RowSpacing="5" Margin="20,0">
            <SearchBar Grid.Row="0"
               Placeholder="Поиск по имени, телефону или почте..."
               Text="{Binding SearchQuery}"  />
            <CollectionView Grid.Row="1"
                    ItemsSource="{Binding SearchResults}"
                    SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="🔍" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Введите запрос для поиска" 
                       Style="{StaticResource CommonLabel}" 
                       HorizontalOptions="Center" Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:User">
                        <Border Style="{StaticResource Card}" Margin="0">
                            <el:MiniUserProfile IsFullNameMode="True" User="{Binding .}">
                                <el:MiniUserProfile.ExtraContent>
                                    <Button ih:IconHelper.Icon="{StaticResource Confirm}"
                                            ih:IconHelper.Size="36"
                                            Style="{StaticResource ImageButton}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CreateChatViewModel}}, Path=AddUserCommand}"
                                            CommandParameter="{Binding .}" />
                                </el:MiniUserProfile.ExtraContent>
                            </el:MiniUserProfile>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Border Style="{StaticResource EditSection}">
            <VerticalStackLayout>
                <Label Text="Участники" Style="{StaticResource SectionTitle}"/>
                <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center" BindableLayout.ItemsSource="{Binding SelectedUsers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:User">
                            <Border Style="{StaticResource Card}" Margin="0">
                                <el:MiniUserProfile ImageIsVisible="False" OnlyFullNameMode="True" User="{Binding .}">
                                    <el:MiniUserProfile.ExtraContent>
                                        <Button ih:IconHelper.Icon="{StaticResource Cancel}" ih:IconHelper.Size="36"
                                                Style="{StaticResource ImageButton}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CreateChatViewModel}}, Path=RemoveUserCommand}"
                                                CommandParameter="{Binding .}" />
                                    </el:MiniUserProfile.ExtraContent>
                                </el:MiniUserProfile>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </Border>
        <!-- Секция: Название группы (только для группового чата) -->
        <VerticalStackLayout IsVisible="{Binding IsGroupChat}" Spacing="5">
            <Label Text="Название группы" Style="{StaticResource BoldCommonLabel}"/>
            <Entry Text="{Binding ChatName}" 
                   Placeholder="Введите название группы"
                   Style="{StaticResource EditEntry}"/>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>