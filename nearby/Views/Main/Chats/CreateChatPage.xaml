<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby.Views.Main.CreateChatPage"
             xmlns:viewModels="clr-namespace:nearby.ViewModels"
             xmlns:models="clr-namespace:nearby.Models"
             x:DataType="viewModels:CreateChatViewModel"
             Title="{Binding PageTitle}"
             Shell.NavBarIsVisible="True">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="20" RowSpacing="10">

        <!-- Секция: Название группы (только для группового чата) -->
        <VerticalStackLayout Grid.Row="0" IsVisible="{Binding IsGroupChat}" Spacing="5">
            <Label Text="Название группы" Style="{StaticResource BoldCommonLabel}"/>
            <Entry Text="{Binding ChatName}" 
                   Placeholder="Введите название группы"
                   Style="{StaticResource EditEntry}"/>
        </VerticalStackLayout>

        <!-- Секция: Выбранные пользователи -->
        <VerticalStackLayout Grid.Row="1" Spacing="5">
            <Label Text="Участники" Style="{StaticResource BoldCommonLabel}"/>
            <FlexLayout Direction="Row" 
                        Wrap="Wrap" 
                        AlignItems="Center"
                        BindableLayout.ItemsSource="{Binding SelectedUsers}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:User">
                        <Border Style="{StaticResource Card}" 
                                Padding="8,4" 
                                Margin="2"
                                StrokeShape="RoundRectangle 15"
                                Stroke="{DynamicResource CBorder}">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding FullName, StringFormat='{0} '}" VerticalOptions="Center"/>
                                <Button Text="{StaticResource Delete}"
                                        FontFamily="MaterialIconsRound"
                                        Style="{StaticResource ImageButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CreateChatViewModel}}, Path=RemoveUserCommand}"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>

        <!-- Секция: Поиск и результаты -->
        <Grid Grid.Row="2" RowDefinitions="Auto, *" RowSpacing="5">
            <SearchBar Grid.Row="0"
                       Placeholder="Поиск по имени, телефону или почте..."
                       Text="{Binding SearchQuery}" />
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding SearchResults}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="🔍" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Введите запрос для поиска" 
                               Style="{StaticResource CommonLabel}" 
                               HorizontalOptions="Center" Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:User">
                        <Border Style="{StaticResource Card}" Padding="10" Margin="0,5">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                <!-- Аватар -->
                                <Border Grid.Column="0" Style="{StaticResource Card}" 
                                        WidthRequest="50" HeightRequest="50" 
                                        StrokeShape="RoundRectangle 25">
                                    <Image Source="{Binding ProfilePicture, TargetNullValue='default_avatar.png'}" 
                                           Aspect="AspectFill" />
                                </Border>
                                <!-- Инфо -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding FullName}" Style="{StaticResource CommonLabel}" FontSize="16"/>
                                    <Label Text="{Binding Phone}" Style="{StaticResource EditLabel}" />
                                    <Label Text="{Binding Email}" Style="{StaticResource EditLabel}" />
                                </VerticalStackLayout>
                                <!-- Кнопка добавления -->
                                <Button Grid.Column="2" 
                                        Text="{StaticResource AddUser}" 
                                        FontFamily="MaterialIconsRound"
                                        Style="{StaticResource ImageButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CreateChatViewModel}}, Path=AddUserCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Кнопка создать чат -->
        <Button Grid.Row="3"
                Text="{Binding IsGroupChat, Converter={StaticResource BoolToCreateButtonTextConverter}}"
                Command="{Binding CreateChatCommand}"
                BackgroundColor="{DynamicResource CPrimary}"
                TextColor="White"
                HeightRequest="50"
                FontSize="18"
                FontAttributes="Bold"/>
    </Grid>
</ContentPage>