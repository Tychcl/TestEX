<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby.Views.Main.ProfilePage"
             xmlns:header="clr-namespace:nearby.Views.Headers"
             xmlns:models="clr-namespace:nearby.Models"
             xmlns:elements="clr-namespace:nearby.ContentViews.Elements"
             xmlns:local="clr-namespace:nearby.ViewModels"
             x:DataType="local:ProfileViewModel">

    <Grid RowDefinitions="Auto, *" RowSpacing="10">
        <!-- Строка 0: информация о пользователе -->
        <ScrollView Grid.Row="0" Orientation="Vertical" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout>
                <!-- Шапка с аватаром -->
                <Grid ColumnDefinitions="Auto, *, Auto" Margin="25, 0" ColumnSpacing="5">
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="{Binding User.Name}" Style="{StaticResource BoldLabel}"/>
                        <Label Text="{Binding User.Surname}" Style="{StaticResource BoldLabel}"/>
                        <Label Text="{Binding User.BirthDate, StringFormat='{0:dd.MM.yyyy}'}" Style="{StaticResource GrayLabel}" Margin="0,7,0,0"/>
                    </VerticalStackLayout>
                    
                    <Image Grid.Column="0"
                           Source="test_profile_image.jpg"
                           HeightRequest="70"
                           WidthRequest="70"
                           Aspect="AspectFill"
                           HorizontalOptions="End"
                           VerticalOptions="Start">
                        <Image.Clip>
                            <RoundRectangleGeometry CornerRadius="15" Rect="0,0,70,70" />
                        </Image.Clip>
                    </Image>

                    <Border Style="{StaticResource Card}" Grid.Column="2" WidthRequest="70" HeightRequest="70" IsVisible="{Binding IsOwnProfile, Converter={StaticResource InverseBoolConverter}}">
                        <Image Source="chats.svg" Scale="0.5" />
                    </Border>

                    <Border Style="{StaticResource Button}" Grid.Column="2" WidthRequest="70" HeightRequest="70" IsVisible="{Binding IsOwnProfile}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}"/>
                        </Border.GestureRecognizers>
                        <Image Source="logout.svg" Scale="0.5" />
                    </Border>

                </Grid>

                <!-- Контакты -->
                <Label Style="{StaticResource BoldLabel}" Text="Контакты" Margin="25, 12"/>

                <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                    <HorizontalStackLayout Spacing="10">
                        <elements:ContactView Image="phone.svg" Title="Телефон" Text="{Binding User.Phone}" Margin="25,0,0,0"/>
                        <elements:ContactView Image="email.svg" Title="Почта" Text="{Binding User.Email}"/>
                        <elements:ContactView Image="telegram.svg" Title="Телеграм" Text="@Tychcl" Margin="0,0,25,0"/>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- О себе и образование -->
                <VerticalStackLayout Margin="25,20">
                    <Label Style="{StaticResource BoldLabel}" Text="О себе"/>
                    <Border Style="{StaticResource Card}" Margin="0,7">
                        <Label Style="{StaticResource CommonLabel}" Text="{Binding User.About}" Padding="3"/>
                    </Border>

                    <Label Style="{StaticResource BoldLabel}" Text="Образование" Margin="0,12"/>
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Padding="3">
                            <Label Style="{StaticResource CommonLabel}" Text="{Binding User.EducationInstitution}" />
                            <Label Style="{StaticResource CommonLabel}" Text="{Binding User.EducationField}" />
                            <Label Style="{StaticResource CommonLabel}" Text="{Binding User.EducationDegree}" TextColor="{StaticResource Gray600}"/>
                            <Label Style="{StaticResource CommonLabel}" TextColor="{StaticResource Gray600}" Margin="0,5,0,0">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0} - {1}">
                                        <Binding Path="User.EducationStartYear" />
                                        <Binding Path="User.EducationEndYear" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Строка 1: блок задач -->
        <Grid Grid.Row="1" RowDefinitions="Auto, *" RowSpacing="10" Margin="25,0,25,10">
            <!-- Табы -->
            <HorizontalStackLayout Grid.Row="0" Spacing="10" HorizontalOptions="Center">
                <Border Padding="15,8" 
                        BackgroundColor="{Binding SelectedCategory, Converter={StaticResource CategoryToColor}, ConverterParameter={x:Static local:TaskCategory.Created}}"
                        StrokeThickness="0">
                    <Label Text="Созданные" TextColor="Black"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" 
                                              CommandParameter="{x:Static local:TaskCategory.Created}"/>
                    </Border.GestureRecognizers>
                </Border>
                <Border Padding="15,8" 
                        BackgroundColor="{Binding SelectedCategory, Converter={StaticResource CategoryToColor}, ConverterParameter={x:Static local:TaskCategory.InProgress}}"
                        StrokeThickness="0">
                    <Label Text="В работе" TextColor="Black"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" 
                                              CommandParameter="{x:Static local:TaskCategory.InProgress}"/>
                    </Border.GestureRecognizers>
                </Border>
                <Border Padding="15,8" 
                        BackgroundColor="{Binding SelectedCategory, Converter={StaticResource CategoryToColor}, ConverterParameter={x:Static local:TaskCategory.Completed}}"
                        StrokeThickness="0">
                    <Label Text="Выполненные" TextColor="Black"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" 
                                              CommandParameter="{x:Static local:TaskCategory.Completed}"/>
                    </Border.GestureRecognizers>
                </Border>
            </HorizontalStackLayout>

            <!-- Список задач -->
            <CollectionView Grid.Row="1" 
                            ItemsSource="{Binding UserTasks}"
                            RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadUserTasksCommand}"
                            VerticalOptions="Fill">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TaskItem">
                        <elements:TaskView Task="{Binding .}" GoToDetailCommand="{Binding Source={RelativeSource AncestorType={x:Type local:ProfileViewModel}}, Path=TaskSelectedCommand}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Border Style="{StaticResource Button}" 
                Grid.Row="2"
                VerticalOptions="End"
                HorizontalOptions="End"
                Margin="0,0,40,40"
                StrokeShape="30"
                IsVisible="{Binding IsOwnProfile}">
            <Image Source="edit.svg" WidthRequest="30" HeightRequest="30"/>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoToEditCommand}"/>
            </Border.GestureRecognizers>
        </Border>
    </Grid>
</ContentPage>