<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby.Views.Main.ProfilePage"
             xmlns:header="clr-namespace:nearby.Views.Headers"
             xmlns:models="clr-namespace:nearby.Models"
             xmlns:elements="clr-namespace:nearby.ContentViews.Elements"
             xmlns:local="clr-namespace:nearby.ViewModels"
             x:DataType="local:ProfileViewModel"
             BackgroundColor="{StaticResource CBackgroundLight}"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarHasShadow="False">

    <Grid RowDefinitions="*">

        <!-- Основной контент -->
        <ScrollView Grid.Row="0" Orientation="Vertical" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="0">

                <!-- Секция: Профиль (аватар + имя) -->
                <Border Style="{StaticResource EditSection}">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16">

                        <!-- Аватар -->
                        <Border Grid.Column="0"
                                WidthRequest="70" HeightRequest="70"
                                Stroke="{StaticResource CBorderLight}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 15">
                            <Image Source="{Binding User.ProfilePicture, TargetNullValue='test_profile_image.jpg'}"
                                   Aspect="AspectFill">
                                <Image.Clip>
                                    <RoundRectangleGeometry CornerRadius="15" Rect="0,0,70,70"/>
                                </Image.Clip>
                            </Image>
                        </Border>

                        <!-- Имя и дата рождения -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding User.Name}" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                            <Label Text="{Binding User.Surname}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                            <Label Text="{Binding User.BirthDate, StringFormat='{0:dd.MM.yyyy}'}" 
                                   Style="{StaticResource EditLabel}"
                                   FontSize="13"/>
                        </VerticalStackLayout>

                        <!-- Кнопки: Чат / Выход -->
                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="8">

                            <!-- Кнопка чата (для чужого профиля) -->
                            <Border Style="{StaticResource Button}" 
                                    WidthRequest="50" HeightRequest="50"
                                    IsVisible="{Binding IsOwnProfile, Converter={StaticResource InverseBoolConverter}}">
                                <Image Source="chats.svg" Scale="0.5"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding StartChatCommand}"/>
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Кнопка выхода (для своего профиля) -->
                            <Border Style="{StaticResource Button}" 
                                    WidthRequest="50" HeightRequest="50"
                                    BackgroundColor="#FFE5E5"
                                    Stroke="#FFCDD2"
                                    IsVisible="{Binding IsOwnProfile}">
                                <Image Source="logout.svg" Scale="0.5"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding LogoutCommand}"/>
                                </Border.GestureRecognizers>
                            </Border>

                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Секция: Контакты -->
                <Border Style="{StaticResource EditSection}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource SectionTitle}" Text="Контакты"/>

                        <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                            <HorizontalStackLayout Spacing="12">
                                <elements:ContactView Image="phone.svg" 
                                                      Title="Телефон" 
                                                      Text="{Binding User.Phone}"
                                                      Margin="0"/>
                                <elements:ContactView Image="email.svg" 
                                                      Title="Почта" 
                                                      Text="{Binding User.Email}"/>
                                <elements:ContactView Image="telegram.svg" 
                                                      Title="Телеграм" 
                                                      Text="@Tychcl"/>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

                <!-- Секция: О себе -->
                <Border Style="{StaticResource EditSection}" IsVisible="{Binding User.About, Converter={StaticResource StringNotEmptyConverter}}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource SectionTitle}" Text="О себе"/>
                        <Label Style="{StaticResource EditEntry}" 
                               Text="{Binding User.About}"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Секция: Образование -->
                <Border Style="{StaticResource EditSection}" 
                        IsVisible="{Binding User.EducationInstitution, Converter={StaticResource StringNotEmptyConverter},
                                         x:DataType=local:ProfileViewModel}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource SectionTitle}" Text="Образование"/>

                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource EditEntry}" 
                                   Text="{Binding User.EducationInstitution}"
                                   FontAttributes="Bold"/>
                            <Label Style="{StaticResource EditLabel}" 
                                   Text="{Binding User.EducationField}"
                                   FontSize="15"/>
                            <Label Style="{StaticResource EditLabel}" 
                                   Text="{Binding User.EducationDegree}" 
                                   TextColor="{StaticResource CTextSecondaryLight}"/>

                            <Label TextColor="{StaticResource CTextSecondaryLight}" Margin="0,8,0,0">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0} — {1}">
                                        <Binding Path="User.EducationStartYear"/>
                                        <Binding Path="User.EducationEndYear"/>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Секция: Статистика аккаунта (только чтение) 
                <Border Style="{StaticResource EditSection}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource SectionTitle}" Text="Статистика"/>

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">

                            <Label Grid.Row="0" Grid.Column="0" Text="Баланс" Style="{StaticResource EditLabel}"/>
                            <Label Grid.Row="0" Grid.Column="1" 
                                   Text="{Binding User.Balance, StringFormat='{0:N2} ₽'}" 
                                   Style="{StaticResource SectionTitle}"/>

                            <Label Grid.Row="1" Grid.Column="0" Text="Рейтинг" Style="{StaticResource EditLabel}"/>
                            <Label Grid.Row="1" Grid.Column="1" 
                                   Text="{Binding User.AverageRating, StringFormat='{0:F1} ⭐'}" 
                                   Style="{StaticResource SectionTitle}"/>

                            <Label Grid.Row="2" Grid.Column="0" Text="Статус" Style="{StaticResource EditLabel}"/>
                            <Label Grid.Row="2" Grid.Column="1" 
                                   Text="{Binding User.AvailabilityStatus}"
                                   TextColor="{StaticResource CPrimaryLight}"
                                   FontAttributes="Bold"/>

                            <Label Grid.Row="3" Grid.Column="0" Text="На сайте с" Style="{StaticResource EditLabel}"/>
                            <Label Grid.Row="3" Grid.Column="1" 
                                   Text="{Binding User.CreatedAt, StringFormat='{0:MMM yyyy}'}"
                                   Style="{StaticResource CommonLabel}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>-->

                <!-- Секция: Задачи (Табы + Список) -->
                <Border Style="{StaticResource EditSection}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource SectionTitle}" Text="Задачи"/>

                        <!-- Табы категорий -->
                        <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal" Margin="-16,-8,-16,8">
                            <HorizontalStackLayout Spacing="8" Padding="16,0">
                                <Border Padding="16,10" 
                                        BackgroundColor="{Binding SelectedCategory, Converter={StaticResource CategoryToColor}, ConverterParameter={x:Static local:TaskCategory.Created}}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10">
                                    <Label Text="Созданные" TextColor="Black" FontAttributes="Bold"/>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" 
                                                              CommandParameter="{x:Static local:TaskCategory.Created}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border Padding="16,10" 
                                        BackgroundColor="{Binding SelectedCategory, Converter={StaticResource CategoryToColor}, ConverterParameter={x:Static local:TaskCategory.InProgress}}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10">
                                    <Label Text="В работе" TextColor="Black" FontAttributes="Bold"/>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" 
                                                              CommandParameter="{x:Static local:TaskCategory.InProgress}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border Padding="16,10" 
                                        BackgroundColor="{Binding SelectedCategory, Converter={StaticResource CategoryToColor}, ConverterParameter={x:Static local:TaskCategory.Completed}}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10">
                                    <Label Text="Выполненные" TextColor="Black" FontAttributes="Bold"/>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" 
                                                              CommandParameter="{x:Static local:TaskCategory.Completed}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </HorizontalStackLayout>
                        </ScrollView>

                        <!-- Список задач -->
                        <CollectionView ItemsSource="{Binding UserTasks}"
                                        RemainingItemsThreshold="3"
                                        RemainingItemsThresholdReachedCommand="{Binding LoadUserTasksCommand}"
                                        VerticalOptions="Fill"
                                        HeightRequest="300">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Padding="20" HorizontalOptions="Center">
                                    <Image Source="empty_tasks.svg" WidthRequest="80" HeightRequest="80" Opacity="0.5"/>
                                    <Label Text="Задач пока нет" 
                                           Style="{StaticResource CommonLabel}" 
                                           TextColor="{StaticResource CTextSecondaryLight}"
                                           HorizontalOptions="Center"
                                           Margin="0,12,0,0"/>
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TaskItem">
                                    <elements:TaskView Task="{Binding .}" 
                                                       GoToDetailCommand="{Binding Source={RelativeSource AncestorType={x:Type local:ProfileViewModel}}, Path=TaskSelectedCommand}"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Floating Action Button: Редактировать (только для своего профиля) -->
        <Border Style="{StaticResource Button}"
                BackgroundColor="{StaticResource CPrimaryLight}"
                StrokeShape="RoundRectangle 30"
                WidthRequest="60" HeightRequest="60"
                VerticalOptions="End"
                HorizontalOptions="End"
                Margin="0,0,25,25"
                IsVisible="{Binding IsOwnProfile}">
            <Image Source="edit.svg" WidthRequest="24" HeightRequest="24" Aspect="AspectFit"/>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoToEditCommand}"/>
            </Border.GestureRecognizers>
        </Border>

    </Grid>
</ContentPage>