<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby.Views.Main.SettingsPage"
             Title="Настройки"
             xmlns:viewModels="clr-namespace:nearby.ViewModels"
             xmlns:clss="clr-namespace:nearby.Classes"
             xmlns:el="clr-namespace:nearby.ContentViews.Elements"
             x:DataType="viewModels:SettingsViewModel">
    <VerticalStackLayout>
        <BoxView HeightRequest="2" BackgroundColor="{DynamicResource CBorder}"/>
        <CollectionView ItemsSource="{Binding SettingsItems}" 
                            SelectionMode="None"
                            VerticalOptions="Fill">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="clss:SettingsItem">
                    <el:SettingsItem Icon="{Binding Icon}" Text="{Binding Text}">
                        <el:SettingsItem.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="{Binding Page}" Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SettingsViewModel}}, Path=GoToPageCommand}"/>
                        </el:SettingsItem.GestureRecognizers>
                    </el:SettingsItem>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>