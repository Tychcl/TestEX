<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:el="clr-namespace:nearby.ContentViews.Elements"
             xmlns:header="clr-namespace:nearby.ContentViews.Headers"
             x:Class="nearby.Views.Main.ThemeChangePage"
             Title="ThemeChangePage">
    <Shell.TitleView>
        <header:BaseHeaderView Text="Настройки темы" BackIsVisible="True"/>
    </Shell.TitleView>
    <ScrollView Margin="0,16,0,0">
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding .}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <el:ThemeMiniView Theme="{Binding .}"/>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>