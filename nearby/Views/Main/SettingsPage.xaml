<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby.Views.Main.SettingsPage"
             Title="SettingsPage"
             xmlns:viewModels="clr-namespace:nearby.ViewModels"
             xmlns:el="clr-namespace:nearby.ContentViews.Elements"
             x:DataType="viewModels:SettingsViewModel">
    <ScrollView Orientation="Vertical">
        <VerticalStackLayout>
            <Grid ColumnDefinitions="auto, *" ColumnSpacing="10">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer />
                </Grid.GestureRecognizers>
                <Image Grid.Column="0" Source="lightdark.svg" Margin="5" Scale="1.2"/>
                <Label Grid.Column="1" Style="{StaticResource EditLabel}" Text="Сменить цветовую тему" HorizontalOptions="Start"/>
            </Grid>
            <CollectionView ItemsSource="{Binding SettingsItems}" 
                        SelectionMode="None"
                        VerticalOptions="Fill">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:SettingsItem">
                        <el:SettingsItem Image="{Binding Image}" Text="{Binding Text}" Page="{Binding Page}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>