<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby.Views.Main.TasksPage"
             xmlns:viewModels="clr-namespace:nearby.ViewModels"
             xmlns:models="clr-namespace:nearby.Models"
             Title="Задачи"
             xmlns:header="clr-namespace:nearby.Views.Headers"
             xmlns:elements="clr-namespace:nearby.ContentViews.Elements"
             x:DataType="viewModels:TasksViewModel">

    <Grid RowDefinitions="Auto, *" Padding="10" RowSpacing="10">
        <HorizontalStackLayout Grid.Row="0" Spacing="5">
            <Picker Title="Статус" SelectedItem="{Binding StatusFilter}" WidthRequest="120">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String></x:String>
                        <x:String>searching</x:String>
                        <x:String>in_progress</x:String>
                        <x:String>completed</x:String>
                        <x:String>cancelled</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Picker Title="Приоритет" SelectedItem="{Binding PriorityFilter}" WidthRequest="120">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String></x:String>
                        <x:String>low</x:String>
                        <x:String>medium</x:String>
                        <x:String>high</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Entry Placeholder="Город" Text="{Binding CityFilter}" WidthRequest="120"/>
        </HorizontalStackLayout>

        <RefreshView Grid.Row="1" 
                     IsRefreshing="{Binding IsRefreshing}" 
                     Command="{Binding RefreshCommand}"
                     VerticalOptions="Fill">
            <CollectionView ItemsSource="{Binding Tasks}" 
                            SelectionMode="None"
                            RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            VerticalOptions="Fill">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TaskItem">
                        <elements:TaskView Task="{Binding .}" GoToDetailCommand="{Binding Source={RelativeSource AncestorType={x:Type viewModels:TasksViewModel}}, Path=GoToDetailCommand}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ImageButton Grid.Row="1"
                     Source="add_circle.svg"
                     VerticalOptions="End"
                     HorizontalOptions="End"
                     Margin="0,0,20,20"
                     WidthRequest="20"
                     HeightRequest="20"
                     Command="{Binding GoToCreateCommand}"/>
    </Grid>
</ContentPage>