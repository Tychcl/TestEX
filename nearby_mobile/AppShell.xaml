<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="nearby_mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:nearby_mobile"
    xmlns:views="clr-namespace:nearby_mobile.Views"
    Title="nearby_mobile">
    <!-- Shell.NavBarIsVisible="False" если надо отлючить хрень сверху-->

    <TabBar>
        <ShellContent Title="Задачи" Icon="tasks.svg" ContentTemplate="{DataTemplate views:TasksPage}" />
        <ShellContent Title="Фонды" Icon="funds.svg" ContentTemplate="{DataTemplate views:MainPage}" />
        <ShellContent Title="Чаты" Icon="chats.svg" ContentTemplate="{DataTemplate views:MainPage}" />
        <ShellContent Title="Настройки" Icon="settings.svg" ContentTemplate="{DataTemplate views:MainPage}" />
        <ShellContent Title="Профиль" Icon="profile.svg" ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>

</Shell>