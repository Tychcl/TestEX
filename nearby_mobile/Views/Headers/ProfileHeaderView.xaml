<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby_mobile.Views.Headers.ProfileHeaderView">
    <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Center">
        <!--<Label Text="{Binding IsOwnProfile}" TextColor="Red"/>-->
        <ImageButton Source="edit.svg" 
                     Command="{Binding GoToEditCommand}" 
                     IsVisible="{Binding IsOwnProfile}"
                     Scale="0.7"/>
        <ImageButton Source="logout.svg" 
                     Command="{Binding LogoutCommand}" 
                     IsVisible="{Binding IsOwnProfile}"
                     Scale="0.7"/>
    </HorizontalStackLayout>
</ContentView>