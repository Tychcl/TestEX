<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby_mobile.Views.ProfilePage"
             xmlns:header="clr-namespace:nearby_mobile.Views.Headers"
             xmlns:local="clr-namespace:nearby_mobile.ViewModels"
             xmlns:models="clr-namespace:nearby_mobile.Models">

    <Shell.TitleView>
        <header:ProfileHeaderView BindingContext="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext}"/>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto, *" RowSpacing="10">
        <!-- Строка 0: информация о пользователе -->
        <ScrollView Grid.Row="0" Orientation="Vertical" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout>
                <!-- Шапка с аватаром -->
                <Grid ColumnDefinitions="Auto, *" Margin="25, 0">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="{Binding Name}" Style="{StaticResource BoldLabel}"/>
                        <Label Text="{Binding Familia}" Style="{StaticResource BoldLabel}"/>
                        <Label Text="{Binding BirthDate}" Style="{StaticResource GrayLabel}" Margin="0,7,0,0"/>
                    </VerticalStackLayout>

                    <Image Grid.Column="1"
                           Source="test_profile_image.jpg"
                           HeightRequest="70"
                           WidthRequest="70"
                           Aspect="AspectFill"
                           HorizontalOptions="End"
                           VerticalOptions="Start">
                        <Image.Clip>
                            <RoundRectangleGeometry CornerRadius="15" Rect="0,0,70,70" />
                        </Image.Clip>
                    </Image>
                </Grid>

                <!-- Контакты -->
                <Label Style="{StaticResource BoldLabel}" Text="Контакты" Margin="25, 12"/>

                <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                    <HorizontalStackLayout Spacing="10">
                        <Border Style="{StaticResource Fields}" Margin="25, 0, 0, 0" Padding="15">
                            <Image Source="chats.svg" Margin="5" Scale="1.2"/>
                        </Border>

                        <Border Style="{StaticResource Contacts}">
                            <Grid ColumnDefinitions="Auto, *" Padding="7">
                                <Image Grid.Column="0" Source="phone.svg" Margin="5" Scale="1.2"/>
                                <Grid Grid.Column="1" HorizontalOptions="Start" RowDefinitions="*, *" Margin="5,0">
                                    <Label Style="{StaticResource BoldLabel}" Grid.Row="0" Text="Телефон" />
                                    <Label Style="{StaticResource GrayLabel}" Grid.Row="1" Text="{Binding Phone}" Margin="0,5,0,0"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Contacts}">
                            <Grid ColumnDefinitions="Auto, *" Padding="7">
                                <Image Grid.Column="0" Source="email.svg" Margin="5" Scale="1.2"/>
                                <Grid Grid.Column="1" HorizontalOptions="Start" RowDefinitions="*, *" Margin="5,0">
                                    <Label Style="{StaticResource BoldLabel}" Grid.Row="0" Text="Почта" />
                                    <Label Style="{StaticResource GrayLabel}" Grid.Row="1" Text="{Binding Email}" Margin="0,5,0,0"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Contacts}" Margin="0,0,25,0">
                            <Grid ColumnDefinitions="Auto, *" Padding="7">
                                <Image Grid.Column="0" Source="telegram.svg" Margin="5" Scale="1.2"/>
                                <Grid Grid.Column="1" HorizontalOptions="Start" RowDefinitions="*, *" Margin="5,0">
                                    <Label Style="{StaticResource BoldLabel}" Grid.Row="0" Text="Телеграм" />
                                    <Label Style="{StaticResource GrayLabel}" Grid.Row="1" Text="@Tychcl" Margin="0,5,0,0"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- О себе и образование -->
                <VerticalStackLayout Margin="25,20">
                    <Label Style="{StaticResource BoldLabel}" Text="О себе"/>
                    <Border Style="{StaticResource Fields}" Margin="0,7">
                        <Label Style="{StaticResource CommonLabel}" Text="{Binding About}" Padding="10"/>
                    </Border>

                    <Label Style="{StaticResource BoldLabel}" Text="Образование" Margin="0,12"/>
                    <Border Style="{StaticResource Fields}">
                        <VerticalStackLayout Padding="10">
                            <Label Style="{StaticResource CommonLabel}" Text="Пермский авиационный техникум имени А.Д. Швецова" />
                            <Label Style="{StaticResource CommonLabel}" Text="2022 - 2026" TextColor="{StaticResource Gray600}" Margin="0,5,0,0"/>
                            <Label Style="{StaticResource CommonLabel}" Text="Среднее специальное" TextColor="{StaticResource Gray600}"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Строка 1: блок задач -->
        <Grid Grid.Row="1" RowDefinitions="Auto, *" RowSpacing="10" Margin="25,0,25,10">
            <!-- Табы -->
            <HorizontalStackLayout Grid.Row="0" Spacing="10" HorizontalOptions="Center">
                <Border Padding="15,8" 
                        BackgroundColor="{Binding SelectedCategory, Converter={StaticResource CategoryToColor}, ConverterParameter={x:Static local:TaskCategory.Created}}"
                        StrokeThickness="0">
                    <Label Text="Созданные" TextColor="Black"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" 
                                              CommandParameter="{x:Static local:TaskCategory.Created}"/>
                    </Border.GestureRecognizers>
                </Border>
                <Border Padding="15,8" 
                        BackgroundColor="{Binding SelectedCategory, Converter={StaticResource CategoryToColor}, ConverterParameter={x:Static local:TaskCategory.InProgress}}"
                        StrokeThickness="0">
                    <Label Text="В работе" TextColor="Black"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" 
                                              CommandParameter="{x:Static local:TaskCategory.InProgress}"/>
                    </Border.GestureRecognizers>
                </Border>
                <Border Padding="15,8" 
                        BackgroundColor="{Binding SelectedCategory, Converter={StaticResource CategoryToColor}, ConverterParameter={x:Static local:TaskCategory.Completed}}"
                        StrokeThickness="0">
                    <Label Text="Выполненные" TextColor="Black"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" 
                                              CommandParameter="{x:Static local:TaskCategory.Completed}"/>
                    </Border.GestureRecognizers>
                </Border>
            </HorizontalStackLayout>

            <!-- Список задач -->
            <CollectionView Grid.Row="1" 
                            ItemsSource="{Binding UserTasks}"
                            RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadUserTasksCommand}"
                            VerticalOptions="Fill">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TaskItem">
                        <Border Style="{StaticResource Card}" Padding="10" Margin="0,5">
                            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontAttributes="Bold" FontSize="14"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Reward, StringFormat='{0:F2}₽'}" TextColor="Green" HorizontalOptions="End"/>
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Location}" TextColor="Gray" FontSize="12"/>
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Deadline, StringFormat='{0:dd.MM.yyyy}'}" TextColor="Gray" FontSize="12" HorizontalOptions="End"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:ProfileViewModel}}, Path=TaskSelectedCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>