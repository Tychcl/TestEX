<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="nearby_mobile.Views.TasksPage"
             xmlns:viewModels="clr-namespace:nearby_mobile.ViewModels"
             Title="Задачи"
             xmlns:header="clr-namespace:nearby_mobile.Views.Headers">

    <Shell.TitleView>
        <header:TasksHeaderView BindingContext="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext}"/>
    </Shell.TitleView>

    <!-- Используем Grid для точного распределения места -->
    <Grid RowDefinitions="Auto, *" Padding="10" RowSpacing="10">
        <!-- Строка 0: Фильтры (Auto) -->
        <HorizontalStackLayout Grid.Row="0" Spacing="5">
            <Picker Title="Статус" SelectedItem="{Binding StatusFilter}" WidthRequest="120">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String></x:String>
                        <x:String>searching</x:String>
                        <x:String>in_progress</x:String>
                        <x:String>completed</x:String>
                        <x:String>cancelled</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Picker Title="Приоритет" SelectedItem="{Binding PriorityFilter}" WidthRequest="120">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String></x:String>
                        <x:String>low</x:String>
                        <x:String>medium</x:String>
                        <x:String>high</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Entry Placeholder="Город" Text="{Binding CityFilter}" WidthRequest="120"/>
        </HorizontalStackLayout>

        <!-- Строка 1: RefreshView с CollectionView (занимает всё оставшееся место) -->
        <RefreshView Grid.Row="1" 
                     IsRefreshing="{Binding IsRefreshing}" 
                     Command="{Binding RefreshCommand}"
                     VerticalOptions="Fill">
            <!-- Важно: Fill или FillAndExpand -->
            <CollectionView ItemsSource="{Binding Tasks}" 
                            SelectionMode="None"
                            RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            VerticalOptions="Fill">
                <!-- И здесь Fill -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItem Text="Удалить" BackgroundColor="Red" 
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:TasksViewModel}}, Path=DeleteTaskCommand}"
                                           CommandParameter="{Binding .}"/>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource Card}" Padding="10" Margin="0,5">
                                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontAttributes="Bold" FontSize="16"/>
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Reward, StringFormat='{0:F2}'}" TextColor="Green" HorizontalOptions="End"/>
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding Location}" TextColor="Gray" FontSize="12"/>
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Deadline, StringFormat='{0:dd.MM.yyyy}'}" TextColor="Gray" FontSize="12" HorizontalOptions="End"/>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:TasksViewModel}}, Path=TaskSelectedCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>